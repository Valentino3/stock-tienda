# Copiá este archivo a .env.local y completá los valores reales.
# .env.local está en .gitignore — nunca se versiona.

# Postgres (Neon). Connection string con sslmode=require.
DATABASE_URL=

# better-auth. Secret aleatorio largo (ej: `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# URL base de la app (ej: http://localhost:3000 en dev).
BETTER_AUTH_URL=http://localhost:3000

# OpenAI (import con IA de documentos: lee facturas foto/PDF). https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo para el import de facturas. Opcional (default gpt-5.1). Cambialo acá si
# el proyecto de OpenAI no tiene habilitado ese modelo.
OPENAI_IMPORT_MODEL=

# Bootstrap (scripts). Super-admin de plataforma:
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Tienda + dueño inicial (npm run seed:store):
STORE_NAME=Mi Comercio
STORE_SLUG=mi-comercio
OWNER_EMAIL=
OWNER_PASSWORD=
