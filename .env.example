# Copiá este archivo a .env.local y completá los valores reales.
# .env.local está en .gitignore — nunca se versiona.

# Postgres (Neon). Connection string con sslmode=require.
DATABASE_URL=

# better-auth. Secret aleatorio largo (ej: `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# URL base de la app (ej: http://localhost:3000 en dev).
BETTER_AUTH_URL=http://localhost:3000

# OpenAI (import con IA de documentos: lee facturas foto/PDF). https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo para el import de facturas. Opcional (default gpt-5.1). Cambialo acá si
# el proyecto de OpenAI no tiene habilitado ese modelo.
OPENAI_IMPORT_MODEL=

# ---- Facturación electrónica ARCA (ex-AFIP) ----
# Clave maestra para cifrar el certificado y la clave privada de cada tienda.
# 32 bytes aleatorios en base64: `openssl rand -base64 32`
# SI SE PIERDE NO HAY RECUPERACIÓN: cada tienda tiene que volver a subir su
# certificado (.crt se re-descarga del portal de ARCA; el .key lo generaste vos
# y hay que conservarlo). Guardá esta clave también fuera de Vercel.
ARCA_MASTER_KEY=
ARCA_MASTER_KEY_ID=k1
# Clave anterior durante una rotación (opcional, SOLO descifra).
ARCA_MASTER_KEY_PREVIOUS=
ARCA_MASTER_KEY_PREVIOUS_ID=
# Habilita los endpoints de PRODUCCIÓN de ARCA. Sin "true", la app NUNCA emite
# comprobantes fiscales reales, aunque la tienda tenga ambiente = produccion.
# Setealo SOLO en el environment Production de Vercel: los previews comparten la
# base de datos de producción y sin esto podrían facturar de verdad.
ARCA_ALLOW_PRODUCCION=

# Bootstrap (scripts). Super-admin de plataforma:
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Tienda + dueño inicial (npm run seed:store):
STORE_NAME=Mi Comercio
STORE_SLUG=mi-comercio
OWNER_EMAIL=
OWNER_PASSWORD=
